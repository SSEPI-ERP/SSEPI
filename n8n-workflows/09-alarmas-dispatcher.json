{
  "name": "SSEPI - Alarmas Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [ { "field": "minutes", "minutesInterval": 1 } ]
        }
      },
      "id": "alarmas-schedule",
      "name": "Every 60 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/alarmas?estado=eq.pendiente&disparar_at=lte.{{$now.toISO()}}&order=disparar_at.asc&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-pending-alarmas",
      "name": "Fetch Pending Alarmas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-alarmas",
              "leftValue": "={{$json.length()}}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-alarmas",
      "name": "If Has Alarmas",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/notificaciones",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "para", "value": "={{$json.para_modulo || 'todos'}}" },
            { "name": "tipo", "value": "={{$json.tipo}}" },
            { "name": "folio", "value": "=ALARMA-{{$json.id.slice(0,8)}}" },
            { "name": "cliente", "value": "" },
            { "name": "mensaje", "value": "={{$json.titulo}}: {{$json.mensaje}}" }
          ]
        },
        "options": {}
      },
      "id": "insert-notificacion",
      "name": "Insert Notificacion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/n8n_insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "module_target", "value": "={{$json.para_modulo}}" },
            { "name": "severity", "value": "={{$json.prioridad}}" },
            { "name": "summary", "value": "={{$json.titulo}}" },
            { "name": "detail", "value": "={{$json.mensaje}}" },
            { "name": "source", "value": "alarmas-dispatcher" }
          ]
        },
        "options": {}
      },
      "id": "insert-insight",
      "name": "Insert n8n Insight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/alarmas?id=eq.{{$json.id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "estado", "value": "disparada" },
            { "name": "disparada_at", "value": "={{$now.toISO()}}" }
          ]
        },
        "options": {}
      },
      "id": "mark-disparada",
      "name": "Mark Disparada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    }
  ],
  "connections": {
    "Every 60 seconds": {
      "main": [ [ { "node": "Fetch Pending Alarmas", "type": "main", "index": 0 } ] ]
    },
    "Fetch Pending Alarmas": {
      "main": [ [ { "node": "If Has Alarmas", "type": "main", "index": 0 } ] ]
    },
    "If Has Alarmas": {
      "main": [ [ { "node": "Insert Notificacion", "type": "main", "index": 0 } ], [] ]
    },
    "Insert Notificacion": {
      "main": [ [ { "node": "Insert n8n Insight", "type": "main", "index": 0 } ] ]
    },
    "Insert n8n Insight": {
      "main": [ [ { "node": "Mark Disparada", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
