{
  "name": "SSEPI - Pipeline Tracker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "folio-stage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-folio",
      "name": "Webhook: folio_stage",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "folio-stage"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/ssepi_folio_operativo?venta_id=eq.{{$json.body.venta_id || $json.venta_id}}&select=*",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-folio",
      "name": "Fetch Folio Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/ssepi_folio_evento?venta_id=eq.{{$json.body.venta_id || $json.venta_id}}&select=*&order=created_at.desc&limit=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "fetch-events",
      "name": "Fetch Recent Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'qwen2.5:3b', messages: [{role: 'system', content: 'Responde SIEMPRE en JSON válido sin markdown. Eres el monitor de pipeline del ERP SSEPI.'}, {role: 'user', content: `Una etapa cambió.\\n\\nFolio operativo: ${JSON.stringify($node['Fetch Folio Data'].json)}\\nEventos recientes: ${JSON.stringify($json)}\\n\\nSLAs esperados:\\n- cotizacion → pedido_pendiente: 3 días\\n- pedido_pendiente → abastecimiento: 2 días\\n- abastecimiento → ejecucion: 5 días\\n- ejecucion → listo_entrega: 10 días\\n- listo_entrega → facturado_timbrado: 3 días\\n- facturado_timbrado → finalizado: 2 días\\n\\nCalcula si la transición está a tiempo o retrasada.\\n\\nResponde en JSON: {\"delayed\": true|false, \"days_elapsed\": N, \"sla_days\": M, \"severity\": \"info\"|\"warning\"|\"critical\", \"summary\": \"resumen en español\", \"detail\": \"explicación\", \"action_suggested\": \"acción o null\"}`}], stream: false, format: 'json', options: { temperature: 0.3 } }) }}",
        "options": {}
      },
      "id": "ollama-check-sla",
      "name": "Ollama: Check SLA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.item.json;\nconst content = resp.message?.content || resp.content || resp.text || '{}';\nlet parsed;\ntry { parsed = typeof content === 'string' ? JSON.parse(content) : content; } catch { parsed = { delayed: false, summary: content, severity: 'info' }; }\nreturn [{ json: { delayed: !!parsed.delayed, severity: parsed.severity || 'info', summary: parsed.summary || 'Transición de pipeline', detail: parsed.detail || '', action_suggested: parsed.action_suggested || null, days_elapsed: parsed.days_elapsed, sla_days: parsed.sla_days } }];"
      },
      "id": "parse-sla-result",
      "name": "Parse SLA Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/n8n_insights",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_name: 'pipeline_tracker', insight_type: 'pipeline_transition', severity: $json.severity || 'info', module_target: 'ventas', summary: $json.summary || 'Transición de pipeline', detail: $json.detail || '', action_suggested: $json.action_suggested || null, payload: { delayed: $json.delayed, days_elapsed: $json.days_elapsed, sla_days: $json.sla_days } }) }}",
        "options": {}
      },
      "id": "save-insight",
      "name": "Save Insight",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            { "leftValue": "={{ $json.delayed }}", "rightValue": "true", "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        }
      },
      "id": "is-delayed",
      "name": "Is Delayed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/notificaciones",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ para: 'ventas', tipo: 'pipeline_delay', mensaje: $json.summary || 'Pipeline retrasado', leido: false, fecha: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "notify-delay",
      "name": "Notify Delay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SUPABASE_SERVICE_ROLE_CRED_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}"
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Webhook: folio_stage": {
      "main": [
        [{ "node": "Fetch Folio Data", "type": "main", "index": 0 }],
        [{ "node": "Fetch Recent Events", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Folio Data": {
      "main": [ [{ "node": "Ollama: Check SLA", "type": "main", "index": 0 }] ]
    },
    "Ollama: Check SLA": {
      "main": [ [{ "node": "Parse SLA Result", "type": "main", "index": 0 }] ]
    },
    "Parse SLA Result": {
      "main": [
        [{ "node": "Save Insight", "type": "main", "index": 0 }],
        [{ "node": "Is Delayed?", "type": "main", "index": 0 }]
      ]
    },
    "Save Insight": {
      "main": [ [{ "node": "Respond OK", "type": "main", "index": 0 }] ]
    },
    "Is Delayed?": {
      "main": [
        [{ "node": "Notify Delay", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Notify Delay": {
      "main": [ [{ "node": "Respond OK", "type": "main", "index": 0 }] ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}