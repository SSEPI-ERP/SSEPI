{
  "name": "ssepi-next",
  "version": "2.0.0",
  "description": "SSEPI-NEXT — Desktop ERP companion with auth, realtime, and COI integration",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "SSEPI",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.ssepi.next",
    "productName": "SSEPI-NEXT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "win": {
      "target": "nsis",
      "icon": "../panel/assets/logo-ssepi.png"
    }
  }
}