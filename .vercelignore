# Exclude unnecessary files from Vercel deployment
.git
.gitignore
*.log
*.tmp
*.bak
*.swp
*~

# Exclude large directories
node_modules/
ollama-data/
backups/
evidencias/
clientes/

# Exclude development/docs
docs/
scripts/migrations/
scripts/*.xlsx
scripts/*.sql
scripts/*.html

# Exclude build artifacts
.vercel/
.vercelignore
dist/

# Exclude other projects / large local-only directories
ssepinext/
landing/node_modules/
mi-coi/
WEB/
ssepi/
simulaciones/
ollama-data/
backups/
clintes/
Compras/
Boom para inventario/
Estilos pdf/
evidenceas/
logs/
tmp/
temp/

# Exclude migration/diagnostic scripts from deploy bundle
ssepinext/probe-*.mjs
ssepinext/test-*.mjs
ssepinext/check-*.mjs
ssepinext/clear-*.mjs
ssepinext/fix-*.mjs
ssepinext/migrar-a-cloud*.mjs
ssepinext/import-n8n-workflows.mjs
ssepinext/truncate-cloud-*.mjs

# Exclude large files
*.zip
*.tar.gz
*.rar
*.7z

# Exclude temp files
*.temp
*.cache
.DS_Store
Thumbs.db
