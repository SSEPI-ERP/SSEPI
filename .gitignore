/core/keys/
*.enc.js
*.key
*.pem
*.crt
*.cer
*.sdg
*.pfx
*.p12

# CSD / certificados SAT del emisor (NUNCA commitear — secretos fiscales)
mi-coi/csd/
mi-coi/config_instituto.json
ssepinext/certs/

# Variables de entorno
.env*
!.env.example

# Scripts con tokens/secretos de cloud (no commitear)
ssepinext/*-cloud-*.mjs
ssepinext/run-cloud-sql.mjs
ssepinext/set-cloud-passwords.mjs
ssepinext/test-cloud-rls.mjs
ssepinext/cloud-diagnostico.mjs
