ssepinext/data/*-report.json

# Logs y temporales
/logs/
*.log
tmp/
temp/

# Build artifacts
.vercel/output/
vercel-output/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SSEPI COI (desktop)
mi-coi/.venv/
mi-coi/.env

# Ollama model data (large binary files)
ollama-data/

